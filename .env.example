# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL (local dev only — use real secrets outside local)
POSTGRES_PORT=5432
POSTGRES_DB=tasks
POSTGRES_USER=tasks
POSTGRES_PASSWORD=change-me

# Host-side URL (alembic, pytest); compose overrides the host to `db` for the api container
# Tests use a separate `<POSTGRES_DB>_test` database, created automatically
DATABASE_URL=postgresql+asyncpg://tasks:change-me@localhost:5432/tasks
